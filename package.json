{
  "name": "ai-banking-market-news",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/ingest/tsconfig.json && tsc --noEmit -p packages/worker/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "ingest": "node --experimental-strip-types packages/ingest/src/run.ts",
    "build:web": "npm run build --workspace @portal/web",
    "dev": "npm run build:web && wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "db:local": "node --experimental-strip-types --no-warnings scripts/migrate.ts",
    "db:remote": "node --experimental-strip-types --no-warnings scripts/migrate.ts --remote",
    "test:watch": "NODE_OPTIONS=--experimental-sqlite vitest",
    "create-admin": "node --experimental-strip-types --no-warnings scripts/create-admin.ts",
    "discover": "node --experimental-strip-types --no-warnings packages/ingest/src/discover.ts",
    "backfill": "node --experimental-strip-types --no-warnings packages/ingest/src/backfill.ts",
    "rescore": "node --experimental-strip-types --no-warnings packages/ingest/src/rescore.ts",
    "rank-sources": "node --experimental-strip-types --no-warnings packages/ingest/src/rank-sources.ts",
    "review:export": "node --experimental-strip-types --no-warnings packages/ingest/src/review-export.ts",
    "review:apply": "node --experimental-strip-types --no-warnings packages/ingest/src/review-apply.ts",
    "dedupe-stories": "node --experimental-strip-types --no-warnings packages/ingest/src/dedupe-stories.ts",
    "probe-swiss-press": "node --experimental-strip-types --no-warnings packages/ingest/src/probe-swiss-press.ts",
    "seed-urls": "node --experimental-strip-types --no-warnings packages/ingest/src/seed-urls.ts",
    "smoke:web": "node scripts/smoke-spa.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.132.0"
  }
}
